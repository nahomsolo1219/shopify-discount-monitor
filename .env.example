SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=shpss_xxxxx
SHOPIFY_SCOPES=read_price_rules,read_discounts
SHOPIFY_ACCESS_TOKEN=              # Optional: set after OAuth to persist across redeployments
APP_URL=https://shopify-discount-monitor-production.up.railway.app
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx
POLL_INTERVAL_MINUTES=5
SHOPIFY_API_VERSION=            # Optional: override the Shopify Admin API version (default 2026-10)
PORT=3000
DATA_DIR=                        # Optional: where state is persisted (default ./data). On Railway, mount a volume and set e.g. /data
HIGH_VALUE_THRESHOLD=500
